/* app.wxss 全局样式 - 性格契合度 */
/* 主题：深蓝星空 + 暖金发光 + 玻璃态半透明卡片 + 粉紫花卉 */

page {
  background: linear-gradient(180deg, #0d0d2b 0%, #1a1a4e 50%, #0d0d2b 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100vh;
}

/* ===== 通用容器 ===== */
.container {
  padding: 30rpx;
  box-sizing: border-box;
}

/* ===== 玻璃态卡片 ===== */
.card {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 32rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 215, 0, 0.95);
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-title::before {
  content: '✦';
  font-size: 24rpx;
  color: rgba(255, 215, 0, 0.6);
}

.card-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 20rpx;
}

.card-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin: 4rpx 0 12rpx;
  line-height: 1.6;
  background: rgba(255, 215, 0, 0.06);
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid rgba(255, 215, 0, 0.3);
}

/* ===== 主按钮（金色玻璃态） ===== */
.btn-primary {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.25), rgba(255, 160, 80, 0.2));
  border: 1rpx solid rgba(255, 215, 0, 0.4);
  color: #ffd700;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 180, 50, 0.2);
  letter-spacing: 2rpx;
  backdrop-filter: blur(8px);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* ===== 次按钮（半透明白） ===== */
.btn-ghost {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.7);
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  backdrop-filter: blur(8px);
}

.btn-ghost:active {
  background: rgba(255, 255, 255, 0.1);
}

/* ===== 分区标题 ===== */
.section-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffd700;
  margin: 10rpx 0 6rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
}

.section-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 24rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  background: rgba(255, 215, 0, 0.1);
  border: 1rpx solid rgba(255, 215, 0, 0.25);
  color: rgba(255, 215, 0, 0.85);
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  margin: 6rpx 10rpx 6rpx 0;
}

.tag-gold {
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
}

.tag-green {
  background: rgba(139, 195, 139, 0.12);
  border-color: rgba(139, 195, 139, 0.3);
  color: rgba(139, 195, 139, 0.9);
}

.tag-pink {
  background: rgba(240, 168, 192, 0.12);
  border-color: rgba(240, 168, 192, 0.3);
  color: rgba(240, 168, 192, 0.9);
}

/* ===== 文本工具 ===== */
.text-gold { color: #ffd700; }
.text-purple { color: #c4a8e8; }
.text-dim { color: rgba(255, 255, 255, 0.4); }
.text-center { text-align: center; }
.font-bold { font-weight: 700; }
.mt20 { margin-top: 20rpx; }
.mt30 { margin-top: 30rpx; }
.mt40 { margin-top: 40rpx; }
.mb20 { margin-bottom: 20rpx; }
.mb30 { margin-bottom: 30rpx; }

/* ===== 选择行（表单通用） ===== */
.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
}
.select-label {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}
.select-right {
  display: flex;
  align-items: center;
}
.select-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffd700;
}
.select-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-left: 12rpx;
}
.select-arrow {
  font-size: 40rpx;
  color: rgba(255, 215, 0, 0.4);
  margin-left: 12rpx;
}
.divider {
  height: 1rpx;
  background: rgba(255, 215, 0, 0.1);
}

/* ===== 文案区块（结果页通用） ===== */
.copy-summary {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.85;
  margin: 8rpx 0 14rpx;
}
.copy-section {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 215, 0, 0.1);
}
.copy-label {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(240, 168, 192, 0.9);
  margin-bottom: 10rpx;
}
.copy-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.9;
}
.copy-item {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.9;
  margin-bottom: 4rpx;
}
.tag-row {
  margin: 10rpx 0;
}

/* ===== 免责声明 ===== */
.disclaimer {
  margin: 30rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ===== 统一底部 Footer ===== */
.page-footer {
  text-align: center;
  padding: 36rpx 0 24rpx;
  margin-top: 20rpx;
}
.footer-line {
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,215,0,0.3), transparent);
  margin: 0 auto 18rpx;
}
.footer-entertain {
  font-size: 22rpx;
  color: rgba(255, 215, 0, 0.5);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}
.footer-copyright {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 1rpx;
}

/* ===== 结论卡片"仅供娱乐"标签 ===== */
.entertain-tag {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  font-size: 20rpx;
  color: rgba(255, 215, 0, 0.5);
  background: rgba(255, 215, 0, 0.06);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}
