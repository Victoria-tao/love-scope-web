<!-- pages/index/index.wxml 性格契合度首页 -->
<view class="page">
  <!-- Hero 区 -->
  <view class="hero">
    <image class="hero-bg" src="{{heroImage}}" mode="aspectFill"></image>
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="hero-badge">✦ 心灵契合 ✦</view>
      <view class="hero-title">性格契合度</view>
      <view class="hero-sub">MBTI 性格心理学<br/>认识自己 · 理解他人</view>
    </view>
  </view>

  <!-- 主入口 -->
  <view class="entries">
    <view class="entry-card entry-pink" bindtap="goMbtiTest">
      <view class="entry-icon">🧪</view>
      <view class="entry-title">MBTI 性格测试</view>
      <view class="entry-desc">16道题 · 测出你的16型人格<br/>认识真实的自己</view>
      <view class="entry-arrow">→</view>
    </view>
    <view class="entry-card entry-gold" bindtap="goMbti">
      <view class="entry-icon">💞</view>
      <view class="entry-title">性格速配</view>
      <view class="entry-desc">MBTI 双人匹配<br/>读懂你们的相处模式</view>
      <view class="entry-arrow">→</view>
    </view>
  </view>

  <!-- 小工具入口 -->
  <view class="mini-entries">
    <view class="mini-entry" bindtap="goPersonal">
      <view class="mini-icon">👤</view>
      <view class="mini-name">性格解读</view>
      <view class="mini-desc">MBTI 深度解析</view>
    </view>
  </view>

  <!-- 特色说明 -->
  <view class="features">
    <view class="feature-item">
      <view class="feature-icon">🧠</view>
      <view class="feature-text">
        <view class="feature-name">心理学基础</view>
        <view class="feature-desc">基于荣格心理类型理论</view>
      </view>
    </view>
    <view class="feature-item">
      <view class="feature-icon">✨</view>
      <view class="feature-text">
        <view class="feature-name">科学性格分类</view>
        <view class="feature-desc">16型人格 · 四维特质分析</view>
      </view>
    </view>
    <view class="feature-item">
      <view class="feature-icon">💞</view>
      <view class="feature-text">
        <view class="feature-name">相处模式</view>
        <view class="feature-desc">性格互补 · 沟通方式解析</view>
      </view>
    </view>
  </view>

  <view class="page-footer">
    <view class="footer-line"></view>
    <view class="footer-entertain">✦ 仅供娱乐参考 ✦</view>
    <view class="footer-copyright">@copyright 2026 Victoria_Tao</view>
  </view>
</view>
