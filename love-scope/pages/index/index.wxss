/* pages/index/index.wxss 首页（星夜玻璃态·B方向排版：入口放大+特色淡化） */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== Hero 区：真实插画背景 ===== */
.hero {
  position: relative;
  height: 560rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #2d1b5e 0%, #4a2c7a 40%, #6b3a8a 70%, #3d256e 100%);
  border-bottom-left-radius: 100rpx;
  border-bottom-right-radius: 100rpx;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(13,13,43,0.3) 0%, rgba(13,13,43,0.1) 40%, rgba(13,13,43,0.7) 100%);
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding-top: 120rpx;
}

.hero-badge {
  display: inline-block;
  background: rgba(255, 215, 0, 0.12);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  color: rgba(255, 215, 0, 0.95);
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  font-size: 80rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 14rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.5), 0 2rpx 12rpx rgba(0, 0, 0, 0.5);
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.5);
}

/* ===== 双入口卡片（B方向：放大突出） ===== */
.entries {
  display: flex;
  gap: 24rpx;
  padding: 0 30rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 3;
}

.entry-card {
  flex: 1;
  border-radius: 32rpx;
  padding: 48rpx 28rpx;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.2s;
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.entry-card:active {
  transform: scale(0.97);
}

.entry-pink {
  background: rgba(240, 168, 192, 0.08);
  border-color: rgba(240, 168, 192, 0.5);
  box-shadow: 0 10rpx 32rpx rgba(240, 168, 192, 0.1);
}

.entry-gold {
  background: rgba(255, 215, 0, 0.06);
  border-color: rgba(255, 215, 0, 0.5);
  box-shadow: 0 10rpx 32rpx rgba(255, 180, 50, 0.1);
}

.entry-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 0 12rpx rgba(255, 215, 0, 0.5));
}

.entry-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.7;
}

.entry-arrow {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: rgba(255, 215, 0, 0.7);
  font-weight: 700;
}

/* ===== 特色列表（B方向：缩小淡化） ===== */
.features {
  margin: 24rpx 30rpx 16rpx;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 215, 0, 0.08);
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 215, 0, 0.05);
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 28rpx;
  margin-right: 20rpx;
  width: 44rpx;
  text-align: center;
  opacity: 0.7;
}

.feature-name {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 2rpx;
}

.feature-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ===== 专业版入口横幅 ===== */
.pro-entry {
  margin: 24rpx 30rpx 0;
  background: linear-gradient(135deg, rgba(120, 80, 200, 0.25), rgba(240, 168, 192, 0.2));
  backdrop-filter: blur(14px);
  border: 1rpx solid rgba(196, 168, 232, 0.4);
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 36rpx rgba(120, 80, 200, 0.25);
  position: relative;
  overflow: hidden;
}
.pro-entry::before {
  content: '✦';
  position: absolute;
  top: -10rpx;
  right: 80rpx;
  font-size: 80rpx;
  color: rgba(255, 215, 0, 0.08);
}
.pro-entry:active { transform: scale(0.98); }
.pro-entry-left { flex: 1; }
.pro-entry-badge {
  display: inline-block;
  background: linear-gradient(135deg, #c4a8e8, #f0a8c0);
  color: #2B1B4E;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}
.pro-entry-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}
.pro-entry-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}
.pro-entry-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pro-entry-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 0 12rpx rgba(196, 168, 232, 0.6));
}
.pro-entry-arrow {
  font-size: 36rpx;
  color: rgba(196, 168, 232, 0.8);
  font-weight: 700;
}

/* ===== MBTI性格速配入口横幅 ===== */
.mbti-entry {
  margin: 20rpx 30rpx 0;
  background: linear-gradient(135deg, rgba(139, 195, 139, 0.25), rgba(240, 168, 192, 0.15));
  backdrop-filter: blur(14px);
  border: 1rpx solid rgba(139, 195, 139, 0.4);
  border-radius: 32rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 30rpx rgba(139, 195, 139, 0.2);
  position: relative;
  overflow: hidden;
}
.mbti-entry::before {
  content: '🧩';
  position: absolute;
  top: -10rpx;
  right: 80rpx;
  font-size: 70rpx;
  opacity: 0.08;
}
.mbti-entry:active { transform: scale(0.98); }
.mbti-entry-left { flex: 1; }
.mbti-entry-badge {
  display: inline-block;
  background: linear-gradient(135deg, #8bc38b, #a8d8a8);
  color: #1a3d1a;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}
.mbti-entry-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}
.mbti-entry-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}
.mbti-entry-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mbti-entry-icon {
  font-size: 44rpx;
  filter: drop-shadow(0 0 12rpx rgba(139, 195, 139, 0.6));
}
.mbti-entry-arrow {
  font-size: 36rpx;
  color: rgba(139, 195, 139, 0.8);
  font-weight: 700;
}

/* 小工具入口 */
.mini-entries {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 30rpx 0;
}

.mini-entry {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  transition: all 0.2s;
}

.mini-entry:active {
  transform: scale(0.96);
  background: rgba(240, 168, 192, 0.1);
}

.mini-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.mini-name {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 4rpx;
}

.mini-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
}
