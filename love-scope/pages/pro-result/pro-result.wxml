<!-- pages/pro-result/pro-result.wxml 专业版深度匹配综合结果 -->
<view class="page {{showShareModal ? 'no-scroll' : ''}}">

  <!-- 顶部综合评分 -->
  <view class="hero-score">
    <image class="hero-bg" src="{{pairTheme.image}}" mode="aspectFill"></image>
    <view class="hero-bg-overlay"></view>
    <view class="hero-bg-deco">✦ ✧ ✦</view>
    <view class="hero-theme" wx:if="{{pairTheme}}">『 {{pairTheme.name}} 』</view>
    <view class="hero-label">六维综合匹配指数</view>
    <view class="hero-score-num">{{totalScore}}</view>
    <view class="hero-level">{{levelTag}}</view>
    <view class="hero-names">{{myInfo.zodiac}} × {{taInfo.zodiac}}</view>
    <view class="hero-animals">属{{myInfo.animal}} · 属{{taInfo.animal}} · {{year}}年度</view>
  </view>

  <!-- 综合总评 -->
  <view class="card summary-card">
    <view class="card-title">💫 综合总评</view>
    <view class="summary-text">{{summaryText}}</view>
    <view class="summary-keywords">
      <text class="kw" wx:for="{{keywords}}" wx:key="index">{{item}}</text>
    </view>
    <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
  </view>

  <!-- 六维雷达 -->
  <view class="card radar-card" hidden="{{showShareModal}}">
    <view class="card-title">📊 六维契合度</view>
    <view class="radar-wrap"><canvas type="2d" id="proRadar" class="radar-canvas"></canvas></view>
    <view class="radar-legend">
      <view class="legend-item" wx:for="{{dimLabels}}" wx:key="index">
        <text class="legend-dot" style="background:{{dimColors[index]}}"></text>
        <text class="legend-name">{{item}}</text>
        <text class="legend-val">{{dimScores[index]}}</text>
      </view>
    </view>
  </view>

  <!-- 星座配对 -->
  <view class="card dim-card" wx:if="{{zodiacPair}}">
    <view class="dim-header">
      <view class="dim-icon">💞</view>
      <view class="dim-title">星座配对</view>
      <view class="dim-score">{{zodiacPair.score}}分</view>
    </view>
    <view class="dim-content">
      <view class="dim-sub">{{zodiacPair.copy.comboName}} · {{zodiacPair.phaseName}}</view>
      <view class="dim-text">{{zodiacPair.copy.summary}}</view>
      <view class="dim-row"><text class="dim-row-label">心动优势</text><text class="dim-row-val">{{zodiacPair.copy.advantage}}</text></view>
      <view class="dim-row"><text class="dim-row-label">相爱挑战</text><text class="dim-row-val">{{zodiacPair.copy.challenge}}</text></view>
    </view>
  </view>

  <!-- 属相配对 -->
  <view class="card dim-card" wx:if="{{animalPair}}">
    <view class="dim-header">
      <view class="dim-icon">🐾</view>
      <view class="dim-title">属相配对</view>
      <view class="dim-score">{{animalPair.score}}分</view>
    </view>
    <view class="dim-content">
      <view class="dim-sub">{{animalPair.relName}} · {{animalPair.relTag}}</view>
      <view class="dim-text">{{animalPair.copy.summary}}</view>
      <view class="dim-row"><text class="dim-row-label">特质契合</text><text class="dim-row-val">{{animalPair.tao.dao}}</text></view>
    </view>
  </view>

  <!-- 出生信息契合 -->
  <view class="card dim-card" wx:if="{{birthMatch}}">
    <view class="dim-header">
      <view class="dim-icon">🎂</view>
      <view class="dim-title">出生信息契合</view>
      <view class="dim-score">{{birthMatch.totalScore}}分</view>
    </view>
    <view class="dim-content">
      <view class="birth-pillars">
        <view class="pillar-mini"><text class="pillar-label-mini">你的年份五行</text><text class="pillar-name-mini">{{birthMatch.myPillar.full}}</text></view>
        <view class="pillar-vs-mini">☯</view>
        <view class="pillar-mini"><text class="pillar-label-mini">TA的年份五行</text><text class="pillar-name-mini">{{birthMatch.taPillar.full}}</text></view>
      </view>
      <view class="dim-row"><text class="dim-row-label">年龄差</text><text class="dim-row-val">{{birthMatch.ageDiff}}岁 · {{birthMatch.ageText}}</text></view>
      <view class="dim-row"><text class="dim-row-label">特质属性</text><text class="dim-row-val">{{birthMatch.stemRel.type}}</text></view>
      <view class="dim-row"><text class="dim-row-label">行为属性</text><text class="dim-row-val">{{birthMatch.branchRel.type}}</text></view>
    </view>
  </view>

  <!-- 性格星图 -->
  <view class="card dim-card astrology" wx:if="{{synastry && natalChart.ta}}">
    <view class="dim-header">
      <view class="dim-icon">🔮</view>
      <view class="dim-title">性格星图</view>
      <view class="dim-score">{{synastry.totalScore}}分</view>
    </view>
    <view class="dim-content">
      <view class="dim-sub">{{synastry.levelTag}} · 综合对比</view>
      <view class="astro-asc">
        <text class="astro-asc-item">你的上升：{{natalChart.my.ascendant.zodiacSymbol}}{{natalChart.my.ascendant.zodiacName}}</text>
        <text class="astro-asc-item">TA的上升：{{natalChart.ta.ascendant.zodiacSymbol}}{{natalChart.ta.ascendant.zodiacName}}</text>
      </view>
      <view class="dim-text">{{synastry.ascendantMatch.text}}</view>
      <view class="astro-mini-row" wx:if="{{synastry.venusMarsAspects.length > 0}}">
        <text class="dim-row-label">吸引力</text>
        <text class="dim-row-val">{{synastry.attractionScore}}分 · {{synastry.venusMarsAspects[0].desc}}</text>
      </view>
      <view class="astro-mini-row" wx:if="{{synastry.sunMoonAspects.length > 0}}">
        <text class="dim-row-label">核心配合</text>
        <text class="dim-row-val">{{synastry.coreFitScore}}分 · {{synastry.sunMoonAspects[0].desc}}</text>
      </view>
    </view>
  </view>

  <!-- 年度契合度 -->
  <view class="card dim-card" wx:if="{{yearFortune}}">
    <view class="dim-header">
      <view class="dim-icon">📅</view>
      <view class="dim-title">{{year}}年度</view>
      <view class="dim-score">{{yearScore}}分</view>
    </view>
    <view class="dim-content">
      <view class="dim-sub">{{yearFortune.ganZhi}} {{yearFortune.animal}}年 · 『{{yearFortune.theme}}』</view>
      <view class="dim-text">{{yearFortune.summary}}</view>
    </view>
  </view>

  <!-- 趣味卡牌 -->
  <view class="card tarot-card">
    <view class="dim-header">
      <view class="dim-icon">🎴</view>
      <view class="dim-title">趣味卡牌灵感</view>
      <view class="dim-score" wx:if="{{tarot}}">{{tarotScore}}分</view>
    </view>
    <view class="tarot-area" wx:if="{{!tarot}}">
      <view class="tarot-pile" bindtap="onDrawTarot">
        <view class="tarot-card-back">
          <view class="tarot-pattern">✦</view>
          <view class="tarot-pattern p2">✧</view>
          <view class="tarot-pattern p3">✦</view>
        </view>
        <view class="tarot-draw-text">点击选一张牌</view>
        <view class="tarot-draw-sub">看看卡牌给这段关系带来什么灵感</view>
      </view>
    </view>
    <view class="tarot-result" wx:if="{{tarot}}">
      <view class="tarot-card-show {{tarot.upright ? '' : 'reversed'}}">
        <image class="tarot-card-image" src="{{tarot.card.image}}" mode="aspectFit" wx:if="{{tarot.card.image}}" />
        <view class="tarot-no">{{tarot.card.no}}</view>
        <view class="tarot-name">{{tarot.card.name}}</view>
        <view class="tarot-en">{{tarot.card.en}}</view>
        <view class="tarot-pos">{{tarot.upright ? '正位' : '逆位'}}</view>
      </view>
      <view class="tarot-keywords">
        <text class="tarot-kw" wx:for="{{tarot.upright ? tarot.card.upright : tarot.card.reversed}}" wx:key="index">{{item}}</text>
      </view>
      <view class="tarot-love">{{tarot.card.love}}</view>
      <view class="tarot-text">{{tarot.upright ? tarot.card.uprightText : tarot.card.reversedText}}</view>
      <view class="tarot-redraw" bindtap="onDrawTarot">重新选牌</view>
    </view>
  </view>

  <!-- 综合性格解读 -->
  <view class="card tao-final" wx:if="{{zodiacPair}}">
    <view class="card-title">☯ 综合性格解读</view>
    <view class="tao-final-text">{{zodiacPair.tao.dao}}</view>
    <view class="tao-final-text">{{zodiacPair.tao.star}}</view>
    <view class="tao-final-seal">气属 {{zodiacPair.me.qi}} × {{zodiacPair.tao.qi}} · 守护特质 {{zodiacPair.me.ruler}} 与 {{zodiacPair.ta.ruler}}</view>
  </view>

  <!-- 操作 -->
  <view class="action-area">
    <view class="btn-share" bindtap="onGenerateShare"><text class="share-icon">📤</text> 生成匹配分享卡</view>
    <view class="btn-ghost mt20" bindtap="goPro">重新匹配</view>
    <view class="btn-ghost mt20" bindtap="goHome">返回首页</view>
  </view>

  <view class="page-footer">
    <view class="footer-line"></view>
    <view class="footer-entertain">✦ 仅供娱乐参考 ✦</view>
    <view class="footer-copyright">@copyright 2026 Victoria_Tao</view>
  </view>

  <view class="share-canvas-wrap"><canvas type="2d" id="shareCanvas" class="share-canvas"></canvas></view>
  <view class="share-modal" wx:if="{{showShareModal}}" bindtap="closeShareModal" catchtouchmove="true">
    <view class="share-modal-content" catchtap="" catchtouchmove="true">
      <view class="share-modal-title">匹配分享卡已生成</view>
      <scroll-view scroll-y class="share-img-scroll">
        <image class="share-modal-img" src="{{shareImg}}" mode="widthFix"></image>
      </scroll-view>
      <view class="share-modal-tip">长按图片可保存或发送给朋友，可上下滑动查看完整内容</view>
      <view class="share-modal-btns">
        <view class="btn-primary share-save" bindtap="onSaveShare">保存到相册</view>
        <view class="btn-ghost share-close" bindtap="closeShareModal">关闭</view>
      </view>
    </view>
  </view>
</view>
