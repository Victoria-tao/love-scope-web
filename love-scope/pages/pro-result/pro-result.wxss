/* pages/pro-result/pro-result.wxss 专业版综合结果页 */
.page { min-height: 100vh; padding-bottom: 60rpx; }
.no-scroll { overflow: hidden; height: 100vh; position: fixed; width: 100%; }

/* 顶部综合评分 */
.hero-score {
  position: relative;
  text-align: center;
  padding: 90rpx 40rpx 70rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  /* 图片本身从上向下渐渐淡出（渐变遮罩） */
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 38%, rgba(0,0,0,0.6) 58%, rgba(0,0,0,0) 82%);
  mask-image: linear-gradient(180deg, #000 0%, #000 38%, rgba(0,0,0,0.6) 58%, rgba(0,0,0,0) 82%);
}
.hero-bg-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  /* 仅顶部轻微压暗保证文字可读，往下渐隐到透明露出页面背景 */
  background: linear-gradient(180deg,
    rgba(13,13,43,0.4) 0%,
    rgba(13,13,43,0.15) 40%,
    rgba(13,13,43,0) 75%);
  z-index: 1;
}
.hero-score .hero-bg-deco,
.hero-score .hero-theme,
.hero-score .hero-label,
.hero-score .hero-score-num,
.hero-score .hero-level,
.hero-score .hero-names,
.hero-score .hero-animals { position: relative; z-index: 2; }
.hero-theme {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255,215,0,0.9);
  letter-spacing: 6rpx;
  margin-bottom: 14rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.6);
}
.hero-bg-deco {
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 40rpx;
  color: rgba(255,215,0,0.15);
  letter-spacing: 20rpx;
}
.hero-label {
  font-size: 24rpx;
  color: rgba(255,215,0,0.7);
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.hero-score-num {
  font-size: 160rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd700, #f0a8c0, #c4a8e8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  margin: 10rpx 0;
  filter: drop-shadow(0 6rpx 24rpx rgba(255,180,50,0.4));
}
.hero-level {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 700;
  color: #c4a8e8;
  background: rgba(196,168,232,0.12);
  border: 1rpx solid rgba(196,168,232,0.35);
  padding: 10rpx 40rpx;
  border-radius: 30rpx;
  margin: 16rpx 0;
}
.hero-names {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 14rpx;
}
.hero-animals {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
}

/* 卡片通用 */
.card {
  margin: 0 30rpx 28rpx;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255,215,0,0.95);
  margin-bottom: 16rpx;
}

/* 综合总评 */
.summary-card {
  background: linear-gradient(135deg, rgba(240,168,192,0.12), rgba(196,168,232,0.1));
  border-color: rgba(240,168,192,0.25);
}
.summary-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.9;
}
.summary-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.kw {
  font-size: 22rpx;
  color: #f0a8c0;
  background: rgba(240,168,192,0.12);
  border: 1rpx solid rgba(240,168,192,0.3);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 雷达 */
.radar-card { background: rgba(255,255,255,0.03); }
.radar-wrap { width: 100%; height: 400rpx; display: flex; align-items: center; justify-content: center; }
.radar-canvas { width: 100%; height: 400rpx; }
.radar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  justify-content: center;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.legend-val { color: rgba(255,215,0,0.9); font-weight: 600; }

/* 维度卡片 */
.dim-card { padding: 28rpx; }
.dim-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.dim-icon { font-size: 36rpx; }
.dim-title {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  flex: 1;
}
.dim-score {
  font-size: 32rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.dim-content {}
.dim-sub {
  font-size: 26rpx;
  color: rgba(255,215,0,0.8);
  margin-bottom: 12rpx;
  font-weight: 600;
}
.dim-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  line-height: 1.8;
  margin-bottom: 14rpx;
}
.dim-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.dim-row:last-child { border-bottom: none; }
.dim-row-label {
  font-size: 24rpx;
  color: rgba(255,215,0,0.65);
  min-width: 130rpx;
  flex-shrink: 0;
  font-weight: 600;
}
.dim-row-val {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  flex: 1;
}

/* 生辰年柱 */
.birth-pillars {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: rgba(255,215,0,0.05);
  border-radius: 16rpx;
}
.pillar-mini { flex: 1; text-align: center; }
.pillar-label-mini { font-size: 20rpx; color: rgba(255,255,255,0.4); display: block; margin-bottom: 6rpx; }
.pillar-name-mini { font-size: 30rpx; font-weight: 700; color: rgba(255,215,0,0.9); }
.pillar-vs-mini { font-size: 28rpx; color: rgba(255,215,0,0.5); padding: 0 12rpx; }

/* 星盘 */
.dim-card.astrology { border-color: rgba(196,168,232,0.25); background: rgba(120,80,200,0.08); }
.astro-asc {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}
.astro-asc-item {
  font-size: 24rpx;
  color: rgba(196,168,232,0.9);
  background: rgba(196,168,232,0.1);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  flex: 1;
  text-align: center;
}
.astro-mini-row {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(196,168,232,0.08);
}
.astro-mini-row:last-child { border-bottom: none; }

/* 塔罗 */
.tarot-card { border-color: rgba(139,157,195,0.25); }
.tarot-area { padding: 30rpx 0; text-align: center; }
.tarot-pile { display: inline-block; }
.tarot-card-back {
  width: 200rpx;
  height: 320rpx;
  background: linear-gradient(135deg, #3D2B6B, #2B1B4E);
  border: 2rpx solid rgba(196,168,232,0.5);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 0 auto 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.4);
}
.tarot-pattern {
  position: absolute;
  font-size: 40rpx;
  color: rgba(196,168,232,0.4);
}
.tarot-pattern { top: 30rpx; left: 50%; transform: translateX(-50%); }
.tarot-pattern.p2 { top: 50%; left: 50%; transform: translate(-50%,-50%); font-size: 60rpx; color: rgba(255,215,0,0.3); }
.tarot-pattern.p3 { bottom: 30rpx; top: auto; }
.tarot-draw-text { font-size: 28rpx; color: #c4a8e8; font-weight: 600; }
.tarot-draw-sub { font-size: 22rpx; color: rgba(255,255,255,0.4); margin-top: 8rpx; }

.tarot-result { text-align: center; }
.tarot-card-show {
  width: 260rpx;
  min-height: 420rpx;
  background: linear-gradient(135deg, rgba(196,168,232,0.2), rgba(240,168,192,0.15));
  border: 2rpx solid rgba(196,168,232,0.5);
  border-radius: 20rpx;
  margin: 0 auto 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx;
}
.tarot-card-image {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.35);
}
.tarot-card-show.reversed { transform: rotate(180deg); }
.tarot-card-show.reversed .tarot-no,
.tarot-card-show.reversed .tarot-name,
.tarot-card-show.reversed .tarot-en,
.tarot-card-show.reversed .tarot-pos { transform: rotate(180deg); }
.tarot-no { font-size: 36rpx; color: rgba(255,215,0,0.6); margin-bottom: 10rpx; }
.tarot-name { font-size: 40rpx; font-weight: 800; color: #fff; margin-bottom: 8rpx; }
.tarot-en { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-bottom: 16rpx; }
.tarot-pos {
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}
.tarot-card-show:not(.reversed) .tarot-pos { background: rgba(139,195,139,0.2); color: #8bc38b; }
.tarot-card-show.reversed .tarot-pos { background: rgba(240,168,192,0.2); color: #f0a8c0; }
.tarot-keywords { display: flex; flex-wrap: wrap; gap: 10rpx; justify-content: center; margin-bottom: 16rpx; }
.tarot-kw {
  font-size: 22rpx;
  color: #c4a8e8;
  background: rgba(196,168,232,0.1);
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
}
.tarot-love {
  font-size: 26rpx;
  color: rgba(255,215,0,0.85);
  font-weight: 600;
  margin-bottom: 14rpx;
  line-height: 1.7;
}
.tarot-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.9;
  text-align: left;
}
.tarot-redraw {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  text-decoration: underline;
}

/* 道家综合 */
.tao-final {
  background: rgba(100,60,160,0.08);
  border-color: rgba(196,168,232,0.2);
}
.tao-final-text {
  font-size: 26rpx;
  color: rgba(200,180,230,0.8);
  line-height: 1.9;
  margin-bottom: 12rpx;
}
.tao-final-seal {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(196,168,232,0.25);
  font-size: 22rpx;
  color: rgba(196,168,232,0.5);
  line-height: 1.7;
}

/* 操作 */
.action-area { padding: 20rpx 30rpx 0; }
.btn-share {
  background: linear-gradient(135deg, rgba(196,168,232,0.3), rgba(240,168,192,0.25));
  border: 1rpx solid rgba(240,168,192,0.4);
  color: #f0a8c0;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(196,168,232,0.2);
}
.btn-share:active { opacity: 0.85; transform: scale(0.98); }
.share-icon { margin-right: 8rpx; }
.btn-ghost {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.7);
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
}
.mt20 { margin-top: 20rpx; }

.disclaimer { margin: 30rpx 0 10rpx; text-align: center; font-size: 22rpx; color: rgba(255,255,255,0.3); }

/* 分享弹窗 */
.share-canvas-wrap { position: fixed; left: -9999rpx; top: 0; width: 750rpx; height: 1334rpx; opacity: 0; pointer-events: none; }
.share-canvas { width: 750rpx; height: 1334rpx; }
.share-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(10,5,30,0.96);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  overflow: hidden;
}
.share-modal-content {
  background: rgba(20,15,50,0.98);
  border: 1rpx solid rgba(255,215,0,0.25);
  border-radius: 36rpx;
  padding: 36rpx 32rpx 32rpx;
  width: 100%;
  max-width: 620rpx;
  overflow: hidden;
}
.share-modal-title { text-align: center; font-size: 32rpx; font-weight: 700; color: #ffd700; margin-bottom: 24rpx; }
.share-img-scroll {
  width: 540rpx;
  height: 900rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(0,0,0,0.2);
}
.share-modal-img {
  width: 100%;
  display: block;
}
.share-modal-tip { text-align: center; font-size: 24rpx; color: rgba(255,255,255,0.5); margin: 20rpx 0 24rpx; }
.share-modal-btns { display: flex; gap: 20rpx; }
.share-save, .share-close { flex: 1; margin-top: 0 !important; font-size: 30rpx !important; }
.share-save { background: linear-gradient(135deg, #c4a8e8, #f0a8c0) !important; color: #2B1B4E !important; border: none !important; }
