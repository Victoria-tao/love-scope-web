<!--pages/daily/daily.wxml-->
<view class="page">
  <view class="header">
    <view class="title">每日日历</view>
    <view class="date">{{selectedDateText}}</view>
    <view class="today-tag" wx:if="{{isSelectedToday}}">今天</view>
  </view>

  <view class="calendar-card">
    <view class="calendar-nav">
      <view class="nav-btn" bindtap="prevMonth">上一月</view>
      <view class="calendar-title">{{currentMonth}}</view>
      <view class="nav-btn" bindtap="nextMonth">下一月</view>
    </view>
    <view class="calendar-week">
      <text class="week-day">日</text>
      <text class="week-day">一</text>
      <text class="week-day">二</text>
      <text class="week-day">三</text>
      <text class="week-day">四</text>
      <text class="week-day">五</text>
      <text class="week-day">六</text>
    </view>
    <view class="calendar-grid">
      <view class="cal-day {{item.isToday?'today':''}} {{item.isSelected?'selected':''}} {{item.isCurrent?'':'empty'}}" wx:for="{{calendarDays}}" wx:key="index" data-day="{{item.day}}" bindtap="onTapDay">{{item.day}}</view>
    </view>
    <view class="today-btn" bindtap="goToday" wx:if="{{!isSelectedToday}}">回到今天</view>
  </view>

  <view class="huangli-card" wx:if="{{huangli}}">
    <view class="huangli-title">今日参考</view>
    <view class="huangli-row">
      <view class="huangli-label yi">宜</view>
      <view class="huangli-content">{{huangli.yi}}</view>
    </view>
    <view class="huangli-row">
      <view class="huangli-label ji">忌</view>
      <view class="huangli-content">{{huangli.ji}}</view>
    </view>
    <view class="huangli-info">
      <text class="info-tag">{{huangli.chong}}</text>
      <text class="info-tag">{{huangli.sha}}</text>
      <text class="info-tag">{{huangli.wuxing}}</text>
    </view>
  </view>

  <view class="selector-card">
    <view class="selector-row">
      <view class="selector-item">
        <view class="selector-label">你的星座</view>
        <picker mode="selector" range="{{zodiacs}}" value="{{zodiacIndex}}" bindchange="onZodiacChange">
          <view class="picker-value">{{zodiacs[zodiacIndex]}}</view>
        </picker>
      </view>
      <view class="selector-item">
        <view class="selector-label">你的属相</view>
        <picker mode="selector" range="{{animals}}" value="{{animalIndex}}" bindchange="onAnimalChange">
          <view class="picker-value">{{animals[animalIndex]}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="summary-card" wx:if="{{summary}}">
    <view class="summary-title">今日综合参考</view>
    <view class="summary-text">{{summary}}</view>
  </view>

  <view class="fortune-card" wx:if="{{zodiacFortune}}">
    <view class="fortune-header">
      <view class="fortune-title">{{zodiacFortune.name}}座</view>
      <view class="fortune-level" style="color:{{zodiacFortune.color}}">{{zodiacFortune.level}} {{zodiacFortune.score}}分</view>
    </view>
    <view class="score-bar">
      <view class="score-fill" style="width:{{zodiacFortune.score}}%;background:{{zodiacFortune.color}};"></view>
    </view>
    <view class="fortune-advice">{{zodiacFortune.advice}}</view>
  </view>

  <view class="fortune-card" wx:if="{{animalFortune}}">
    <view class="fortune-header">
      <view class="fortune-title">{{animalFortune.name}}年</view>
      <view class="fortune-level" style="color:{{animalFortune.color}}">{{animalFortune.level}} {{animalFortune.score}}分</view>
    </view>
    <view class="score-bar">
      <view class="score-fill" style="width:{{animalFortune.score}}%;background:{{animalFortune.color}};"></view>
    </view>
    <view class="fortune-advice">{{animalFortune.advice}}</view>
  </view>

  <view class="btn-ghost" bindtap="goHome">返回首页</view>

  <view class="page-footer">
    <view class="footer-line"></view>
    <view class="footer-entertain">仅供娱乐参考</view>
    <view class="footer-copyright">@copyright 2026 Victoria_Tao</view>
  </view>
</view>
