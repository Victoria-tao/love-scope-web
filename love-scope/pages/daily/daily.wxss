/* pages/daily/daily.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 20rpx 0 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.date {
  font-size: 28rpx;
  color: #ffd700;
}

.today-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #2d1b5e;
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
}

/* 日历卡片 */
.calendar-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.nav-btn {
  font-size: 22rpx;
  color: rgba(255, 215, 0, 0.6);
  padding: 8rpx 16rpx;
  background: rgba(255, 215, 0, 0.06);
  border-radius: 16rpx;
}

.nav-btn:active {
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
}

.calendar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffd700;
  letter-spacing: 2rpx;
}

.calendar-week {
  display: flex;
  margin-bottom: 10rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  padding: 8rpx 0;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-day {
  flex: 0 0 14.2857%;
  width: 14.2857%;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  transition: all 0.2s;
  box-sizing: border-box;
}

.cal-day:active {
  background: rgba(255, 255, 255, 0.1);
}

.cal-day.today {
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-weight: 800;
}

.cal-day.selected {
  border: 2rpx solid #ffd700;
  color: #ffd700;
  font-weight: 700;
}

.cal-day.selected.today {
  border: 2rpx solid #fff;
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.6);
}

.cal-day.empty {
  color: transparent;
}

.today-btn {
  text-align: center;
  font-size: 22rpx;
  color: #f0a8c0;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 215, 0, 0.1);
}

/* 黄历卡片 */
.huangli-card {
  background: rgba(255, 215, 0, 0.06);
  border: 1rpx solid rgba(255, 215, 0, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.huangli-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffd700;
  text-align: center;
  margin-bottom: 18rpx;
}

.huangli-row {
  display: flex;
  margin-bottom: 14rpx;
  align-items: flex-start;
}

.huangli-label {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.huangli-label.yi {
  background: rgba(139, 195, 139, 0.2);
  color: #8bc38b;
}

.huangli-label.ji {
  background: rgba(240, 168, 192, 0.2);
  color: #f0a8c0;
}

.huangli-content {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.8);
}

.huangli-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 215, 0, 0.1);
}

.info-tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

/* 选择器 */
.selector-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.selector-row {
  display: flex;
  gap: 16rpx;
}

.selector-item {
  flex: 1;
}

.selector-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.picker-value {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 215, 0, 0.2);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  color: #ffd700;
}

/* 综合总结 */
.summary-card {
  background: linear-gradient(135deg, rgba(240, 168, 192, 0.12), rgba(196, 168, 232, 0.12));
  border: 1rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffd700;
  margin-bottom: 12rpx;
}

.summary-text {
  font-size: 24rpx;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.85);
}

/* 运势卡片 */
.fortune-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.fortune-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.fortune-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.fortune-level {
  font-size: 26rpx;
  font-weight: 800;
}

.score-bar {
  width: 100%;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.score-fill {
  height: 100%;
  border-radius: 5rpx;
}

.fortune-advice {
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.75);
}

.btn-ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  text-align: center;
  padding: 22rpx;
  border-radius: 40rpx;
  margin: 20rpx 0;
}

.page-footer {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.footer-line {
  width: 120rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 auto 16rpx;
}

.footer-entertain {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}
