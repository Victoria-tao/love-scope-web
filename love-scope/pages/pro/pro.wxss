/* pages/pro/pro.wxss 专业版输入页 */
.page { min-height: 100vh; padding-bottom: 60rpx; }

.pro-header {
  position: relative;
  text-align: center;
  padding: 50rpx 40rpx 36rpx;
  overflow: hidden;
}
.pro-header-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
.pro-header-overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(13,13,43,0.35) 0%, rgba(13,13,43,0.15) 45%, rgba(13,13,43,0.75) 100%);
  z-index: 1;
}
.pro-header-content { position: relative; z-index: 2; }
.pro-badge {
  display: inline-block;
  background: linear-gradient(135deg, #c4a8e8, #f0a8c0);
  color: #2B1B4E;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}
.pro-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 14rpx;
  text-shadow: 0 0 20rpx rgba(196,168,232,0.4);
}
.pro-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.8;
}

.person-card {
  margin: 0 30rpx 28rpx;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(196,168,232,0.2);
  border-radius: 32rpx;
  padding: 32rpx 28rpx 24rpx;
}
.person-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(196,168,232,0.12);
}
.person-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}
.person-avatar.my { background: linear-gradient(135deg, #f0a8c0, #e8956a); }
.person-avatar.ta { background: linear-gradient(135deg, #c4a8e8, #8b9dc3); }
.person-avatar.year { background: linear-gradient(135deg, #ffd700, #ff8c42); font-size: 28rpx; }
.person-title {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.form-row:last-child { border-bottom: none; }
.form-label {
  font-size: 26rpx;
  color: rgba(255,215,0,0.75);
  min-width: 150rpx;
  flex-shrink: 0;
  font-weight: 600;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.form-picker {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.form-picker.small {
  flex: 1;
  text-align: center;
  padding: 16rpx 10rpx;
  font-size: 26rpx;
}
.form-picker.ph { color: rgba(255,255,255,0.3); }
.form-date-group {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.auto-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(139,195,139,0.85);
  background: rgba(139,195,139,0.08);
  border: 1rpx solid rgba(139,195,139,0.2);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  display: inline-block;
}

.ready-hint {
  margin: 0 30rpx 24rpx;
  background: rgba(255,215,0,0.08);
  border: 1rpx solid rgba(255,215,0,0.2);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.ready-icon { font-size: 28rpx; flex-shrink: 0; }
.ready-text { font-size: 24rpx; color: rgba(255,215,0,0.8); line-height: 1.7; flex: 1; }

.submit-area {
  padding: 20rpx 30rpx 0;
}
.btn-pro {
  background: linear-gradient(135deg, #c4a8e8, #f0a8c0);
  color: #2B1B4E;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(196,168,232,0.4);
  letter-spacing: 2rpx;
}
.btn-pro:active { opacity: 0.9; transform: scale(0.98); }
.btn-pro.disabled {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.35);
  box-shadow: none;
}
.btn-icon { margin-right: 10rpx; }
.submit-note {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  margin-top: 16rpx;
  line-height: 1.6;
}
