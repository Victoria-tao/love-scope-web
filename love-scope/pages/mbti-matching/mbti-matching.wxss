/* pages/mbti-matching/mbti-matching.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a0f3d 0%, #2d1b5e 50%, #150a2e 100%);
  padding: 40rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-badge {
  display: inline-block;
  font-size: 24rpx;
  color: rgba(255, 215, 0, 0.7);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.person-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  backdrop-filter: blur(10rpx);
}

.person-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.person-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 20rpx;
}

.person-avatar.my {
  background: linear-gradient(135deg, #f0a8c0, #e8956a);
}

.person-avatar.ta {
  background: linear-gradient(135deg, #c4a8e8, #8bc38b);
}

.person-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.form-row {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 10rpx;
}

.form-picker {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #fff;
}

.ready-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 215, 0, 0.1);
  border: 1rpx solid rgba(255, 215, 0, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.ready-icon {
  margin-right: 10rpx;
}

.ready-text {
  font-size: 26rpx;
  color: rgba(255, 215, 0, 0.8);
}

.submit-area {
  margin-top: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #f0a8c0, #c4a8e8);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 28rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(240, 168, 192, 0.3);
}

.btn-primary.disabled {
  opacity: 0.4;
}

.submit-note {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 16rpx;
}

.page-footer {
  margin-top: 60rpx;
  text-align: center;
}

.footer-line {
  width: 120rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.15);
  margin: 0 auto 20rpx;
}

.footer-entertain {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: 20rpx;
  color: rgba(255, 215, 0, 0.25);
}
