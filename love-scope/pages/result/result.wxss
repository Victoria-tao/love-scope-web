/* pages/result/result.wxss 结果页（B方向+生辰+专业星盘） */

.page { min-height: 100vh; padding-bottom: 60rpx; }

.pair-illustration { position: relative; height: 420rpx; margin: 0 0 30rpx; overflow: hidden; }
.illu-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.illu-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(13,13,43,0.2) 0%, rgba(13,13,43,0.1) 40%, rgba(13,13,43,0.6) 100%); z-index: 1; }
.illu-content { position: relative; z-index: 2; text-align: center; padding-top: 200rpx; }
.illu-theme { font-size: 26rpx; font-weight: 600; color: rgba(255,215,0,0.9); letter-spacing: 6rpx; margin-bottom: 10rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.6); }
.illu-names { font-size: 44rpx; font-weight: 800; color: #fff; letter-spacing: 2rpx; margin-bottom: 8rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.6), 0 0 20rpx rgba(255,215,0,0.3); }
.illu-qi { font-size: 22rpx; color: rgba(255,255,255,0.7); letter-spacing: 2rpx; text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.5); }

/* 分数卡 */
.score-card { margin: 0 30rpx 32rpx; background: rgba(20,15,50,0.65); backdrop-filter: blur(18px); border-radius: 36rpx; padding: 52rpx 40rpx; text-align: center; border: 1rpx solid rgba(255,215,0,0.3); box-shadow: 0 14rpx 48rpx rgba(0,0,0,0.45), 0 0 40rpx rgba(255,180,50,0.15); position: relative; overflow: hidden; }
.score-card::before { content: '✦'; position: absolute; top: 28rpx; right: 36rpx; font-size: 32rpx; color: rgba(255,215,0,0.35); }
.score-names { font-size: 32rpx; font-weight: 700; color: rgba(255,215,0,0.95); margin-bottom: 18rpx; }
.score-big { font-size: 150rpx; font-weight: 800; background: linear-gradient(135deg, #ffd700, #ff8c42); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; margin: 12rpx 0; filter: drop-shadow(0 6rpx 20rpx rgba(255,180,50,0.5)); }
.score-label { font-size: 24rpx; color: rgba(255,255,255,0.45); letter-spacing: 8rpx; margin-bottom: 16rpx; }
.score-tag { display: inline-block; background: linear-gradient(135deg, rgba(255,215,0,0.35), rgba(255,140,66,0.3)); border: 1rpx solid rgba(255,215,0,0.45); color: #ffd700; font-size: 28rpx; font-weight: 600; padding: 10rpx 36rpx; border-radius: 32rpx; margin-bottom: 14rpx; }
.score-phase { font-size: 26rpx; color: rgba(255,255,255,0.55); margin-top: 10rpx; }

/* 生辰卡 */
.birth-card { background: rgba(255,215,0,0.06); border: 1rpx solid rgba(255,215,0,0.2); border-radius: 32rpx; padding: 32rpx; backdrop-filter: blur(12px); }
.birth-card .card-title { color: rgba(255,215,0,0.95); font-size: 32rpx; }
.birth-score-row { display: flex; align-items: center; gap: 28rpx; margin: 16rpx 0 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid rgba(255,215,0,0.12); }
.birth-score-num { font-size: 80rpx; font-weight: 800; background: linear-gradient(135deg, #ffd700, #ff8c42); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; min-width: 120rpx; text-align: center; }
.birth-score-info { flex: 1; }
.birth-score-tag { display: inline-block; background: rgba(255,215,0,0.15); border: 1rpx solid rgba(255,215,0,0.3); color: #ffd700; font-size: 24rpx; font-weight: 600; padding: 6rpx 20rpx; border-radius: 20rpx; margin-bottom: 8rpx; }
.birth-score-label { font-size: 22rpx; color: rgba(255,255,255,0.45); }
.birth-pillars { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; padding: 20rpx 16rpx; background: rgba(255,255,255,0.03); border-radius: 20rpx; }
.pillar-item { flex: 1; text-align: center; }
.pillar-label { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-bottom: 8rpx; }
.pillar-name { font-size: 36rpx; font-weight: 700; color: rgba(255,215,0,0.95); margin-bottom: 6rpx; letter-spacing: 4rpx; }
.pillar-elem { font-size: 22rpx; color: rgba(255,200,150,0.7); }
.pillar-vs { font-size: 32rpx; color: rgba(255,215,0,0.5); padding: 0 16rpx; }
.birth-detail { margin-top: 8rpx; }
.birth-detail-row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid rgba(255,215,0,0.06); align-items: flex-start; }
.birth-detail-row:last-child { border-bottom: none; }
.birth-detail-label { font-size: 24rpx; color: rgba(255,215,0,0.7); min-width: 130rpx; flex-shrink: 0; font-weight: 600; }
.birth-detail-val { font-size: 24rpx; color: rgba(255,255,255,0.7); line-height: 1.7; flex: 1; }

/* 专业星盘卡 */
.astrology-card { background: rgba(80, 50, 140, 0.1); border: 1rpx solid rgba(160, 130, 220, 0.25); border-radius: 32rpx; padding: 32rpx; backdrop-filter: blur(12px); }
.astrology-card .card-title { color: rgba(196,168,232,0.95); font-size: 32rpx; }
.astro-score-row { display: flex; align-items: center; gap: 28rpx; margin: 16rpx 0 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid rgba(160,130,220,0.15); }
.astro-score-num { font-size: 80rpx; font-weight: 800; background: linear-gradient(135deg, #c4a8e8, #f0a8c0); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; min-width: 120rpx; text-align: center; }
.astro-score-info { flex: 1; }
.astro-score-tag { display: inline-block; background: rgba(196,168,232,0.15); border: 1rpx solid rgba(196,168,232,0.35); color: #c4a8e8; font-size: 24rpx; font-weight: 600; padding: 6rpx 20rpx; border-radius: 20rpx; margin-bottom: 8rpx; }
.astro-score-label { font-size: 22rpx; color: rgba(255,255,255,0.45); }
.astro-section { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(160,130,220,0.1); }
.astro-section:first-of-type { border-top: none; margin-top: 0; padding-top: 0; }
.astro-section-title { font-size: 26rpx; font-weight: 700; color: rgba(196,168,232,0.85); margin-bottom: 14rpx; }
.astro-match-text { font-size: 24rpx; color: rgba(220,200,240,0.75); line-height: 1.8; margin-top: 12rpx; }

/* 行星表格 */
.planet-table { margin-top: 8rpx; }
.planet-row { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid rgba(160,130,220,0.08); }
.planet-row.head { font-weight: 700; color: rgba(196,168,232,0.6); font-size: 22rpx; }
.planet-row:last-child { border-bottom: none; }
.planet-name { font-size: 26rpx; color: rgba(255,255,255,0.8); min-width: 120rpx; flex-shrink: 0; }
.planet-zodiac { font-size: 24rpx; color: rgba(255,215,0,0.85); flex: 1; text-align: center; }
.planet-vs { font-size: 20rpx; color: rgba(255,255,255,0.3); min-width: 40rpx; text-align: center; }
.planet-house { font-size: 22rpx; color: rgba(196,168,232,0.6); min-width: 100rpx; text-align: right; }

/* 相位 */
.aspect-item { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid rgba(160,130,220,0.08); }
.aspect-item:last-child { border-bottom: none; }
.aspect-desc { font-size: 24rpx; color: rgba(220,200,240,0.8); flex: 1; }
.aspect-type { font-size: 22rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: 14rpx; flex-shrink: 0; margin-left: 16rpx; }
.aspect-type.pos { background: rgba(139,195,139,0.15); color: #8bc38b; border: 1rpx solid rgba(139,195,139,0.3); }
.aspect-type.neg { background: rgba(240,168,192,0.15); color: #f0a8c0; border: 1rpx solid rgba(240,168,192,0.3); }

/* 雷达卡 */
.radar-card { background: rgba(255,255,255,0.03); border-color: rgba(255,215,0,0.08); opacity: 0.85; }
.radar-wrap { width: 100%; height: 360rpx; display: flex; align-items: center; justify-content: center; }
.radar-canvas { width: 100%; height: 360rpx; }

/* 卡片通用 */
.card { margin: 0 30rpx 28rpx; }
.card-title { font-size: 32rpx; font-weight: 700; color: rgba(255,215,0,0.95); margin-bottom: 14rpx; }

/* 主卡 */
.main-card { background: rgba(240,168,192,0.1); border: 1rpx solid rgba(240,168,192,0.3); border-radius: 32rpx; padding: 36rpx 32rpx; box-shadow: 0 10rpx 36rpx rgba(240,168,192,0.12); backdrop-filter: blur(12px); }
.main-card .card-title { color: rgba(255,200,180,0.98); font-size: 36rpx; }

/* 次卡 */
.tao-card { width: 80%; margin: 0 auto 28rpx; background: rgba(100,60,160,0.08); border: 1rpx solid rgba(196,168,232,0.2); border-radius: 28rpx; padding: 28rpx; backdrop-filter: blur(10px); opacity: 0.9; }
.tao-card .card-title { color: rgba(196,168,232,0.85); font-size: 28rpx; }
.tao-line { font-size: 26rpx; color: rgba(200,180,230,0.75); line-height: 1.9; margin-bottom: 10rpx; padding-left: 8rpx; }
.tao-seal { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx dashed rgba(196,168,232,0.25); font-size: 20rpx; color: rgba(196,168,232,0.5); line-height: 1.7; }
.tao-quote { font-style: italic; color: rgba(200,180,230,0.7); border-left: 4rpx solid rgba(196,168,232,0.35); padding-left: 16rpx; }

.person-tag { display: inline-block; background: rgba(139,195,139,0.15); border: 1rpx solid rgba(139,195,139,0.35); color: rgba(139,195,139,0.95); font-size: 26rpx; font-weight: 600; padding: 10rpx 28rpx; border-radius: 30rpx; margin-top: 8rpx; }
.animal-top { display: flex; align-items: center; gap: 20rpx; margin: 10rpx 0; }
.animal-score { font-size: 68rpx; font-weight: 800; background: linear-gradient(135deg, #ffd700, #ff8c42); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; }
.animal-tag { display: inline-block; background: rgba(255,215,0,0.1); border: 1rpx solid rgba(255,215,0,0.25); color: rgba(255,215,0,0.85); font-size: 26rpx; font-weight: 600; padding: 8rpx 24rpx; border-radius: 24rpx; }
.year-card { background: rgba(60,60,140,0.12); border-color: rgba(140,140,220,0.25); }
.year-ganzhi { font-size: 30rpx; font-weight: 700; color: rgba(180,180,240,0.95); margin: 8rpx 0 16rpx; }

.action-area { padding: 20rpx 30rpx 0; }
.btn-share { background: linear-gradient(135deg, rgba(196,168,232,0.25), rgba(240,168,192,0.2)); border: 1rpx solid rgba(240,168,192,0.4); color: #f0a8c0; border-radius: 48rpx; font-size: 32rpx; font-weight: 600; padding: 24rpx 0; text-align: center; box-shadow: 0 8rpx 24rpx rgba(196,168,232,0.2); letter-spacing: 2rpx; backdrop-filter: blur(8px); }
.btn-share:active { opacity: 0.85; transform: scale(0.98); }
.share-icon { margin-right: 8rpx; }

.share-canvas-wrap { position: fixed; left: -9999rpx; top: 0; width: 750rpx; height: 2200rpx; opacity: 0; pointer-events: none; }
.share-canvas { width: 750rpx; height: 2200rpx; }

.share-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); z-index: 999; display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.share-modal-content { background: rgba(20,15,50,0.95); backdrop-filter: blur(20px); border: 1rpx solid rgba(255,215,0,0.25); border-radius: 36rpx; padding: 36rpx 32rpx 32rpx; width: 100%; max-width: 620rpx; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5); }
.share-modal-title { text-align: center; font-size: 32rpx; font-weight: 700; color: #ffd700; margin-bottom: 24rpx; flex-shrink: 0; }
.share-modal-scroll { flex: 1; max-height: 55vh; margin-bottom: 20rpx; }
.share-modal-img { width: 100%; border-radius: 20rpx; display: block; }
.share-modal-tip { text-align: center; font-size: 24rpx; color: rgba(255,255,255,0.5); margin: 0 0 24rpx; flex-shrink: 0; }
.share-modal-btns { display: flex; gap: 20rpx; flex-shrink: 0; }
.share-save, .share-close { flex: 1; margin-top: 0 !important; font-size: 30rpx !important; }

.disclaimer { margin: 30rpx 0 10rpx; text-align: center; font-size: 22rpx; color: rgba(255,255,255,0.3); }
