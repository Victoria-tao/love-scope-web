<!-- pages/result/result.wxml 性格契合度结果页 -->
<view class="page">

  <!-- 配对插画背景区 -->
  <view class="pair-illustration" wx:if="{{zodiacPair && pairTheme}}" style="background:{{pairTheme.bg}}">
    <image class="illu-bg" src="{{pairTheme.image}}" mode="aspectFill"></image>
    <view class="illu-overlay"></view>
    <view class="illu-content">
      <view class="illu-theme">『 {{pairTheme.name}} 』</view>
      <view class="illu-names">{{zodiacPair.me.name}} × {{zodiacPair.ta.name}}</view>
      <view class="illu-qi">气属 {{zodiacPair.me.qi}} · {{zodiacPair.ta.qi}}</view>
    </view>
  </view>

  <!-- 星座配对 -->
  <block wx:if="{{zodiacPair}}">
    <view class="score-card">
      <view class="score-names">{{zodiacPair.me.name}} ♥ {{zodiacPair.ta.name}}</view>
      <view class="score-big">{{zodiacPair.score}}</view>
      <view class="score-label">契合指数</view>
      <view class="score-tag">{{zodiacPair.levelTag}}</view>
      <view class="score-phase">{{zodiacPair.phaseName}} · {{zodiacPair.copy.comboName}}</view>
    </view>

    <!-- 出生信息契合度 -->
    <view class="card birth-card" wx:if="{{birthMatch}}">
      <view class="card-title">🎂 出生信息契合度</view>
      <view class="birth-score-row">
        <view class="birth-score-num">{{birthMatch.totalScore}}</view>
        <view class="birth-score-info">
          <view class="birth-score-tag">{{birthMatch.levelTag}}</view>
          <view class="birth-score-label">出生信息综合指数</view>
        </view>
      </view>
      <view class="birth-pillars">
        <view class="pillar-item">
          <view class="pillar-label">你的年份五行</view>
          <view class="pillar-name">{{birthMatch.myPillar.full}}</view>
          <view class="pillar-elem">{{birthMatch.myPillar.stemElement}}·{{birthMatch.myPillar.branchElement}}</view>
        </view>
        <view class="pillar-vs">☯</view>
        <view class="pillar-item">
          <view class="pillar-label">TA的年份五行</view>
          <view class="pillar-name">{{birthMatch.taPillar.full}}</view>
          <view class="pillar-elem">{{birthMatch.taPillar.stemElement}}·{{birthMatch.taPillar.branchElement}}</view>
        </view>
      </view>
      <view class="birth-detail">
        <view class="birth-detail-row"><text class="birth-detail-label">年龄差</text><text class="birth-detail-val">{{birthMatch.ageDiff}}岁 · {{birthMatch.ageText}}</text></view>
        <view class="birth-detail-row"><text class="birth-detail-label">年份属性</text><text class="birth-detail-val">{{birthMatch.stemRel.type}} · {{birthMatch.stemRel.text}}</text></view>
        <view class="birth-detail-row"><text class="birth-detail-label">地支属性</text><text class="birth-detail-val">{{birthMatch.branchRel.type}} · {{birthMatch.branchRel.text}}</text></view>
        <view class="birth-detail-row" wx:if="{{birthMatch.seasonText}}"><text class="birth-detail-label">生日季节</text><text class="birth-detail-val">{{birthMatch.seasonText}}</text></view>
      </view>
    </view>

    <!-- 专业性格星图配对 -->
    <view class="card astrology-card" wx:if="{{synastry && natalChart.ta}}">
      <view class="card-title">🔮 专业性格星图配对</view>
      <view class="astro-score-row">
        <view class="astro-score-num">{{synastry.totalScore}}</view>
        <view class="astro-score-info">
          <view class="astro-score-tag">{{synastry.levelTag}}</view>
          <view class="astro-score-label">比较盘综合指数</view>
        </view>
      </view>
      <view class="astro-section">
        <view class="astro-section-title">上升星座</view>
        <view class="birth-pillars">
          <view class="pillar-item">
            <view class="pillar-label">你的上升</view>
            <view class="pillar-name">{{natalChart.my.ascendant.zodiacSymbol}} {{natalChart.my.ascendant.zodiacName}}</view>
          </view>
          <view class="pillar-vs">×</view>
          <view class="pillar-item">
            <view class="pillar-label">TA的上升</view>
            <view class="pillar-name">{{natalChart.ta.ascendant.zodiacSymbol}} {{natalChart.ta.ascendant.zodiacName}}</view>
          </view>
        </view>
        <view class="astro-match-text">{{synastry.ascendantMatch.text}}</view>
      </view>
      <view class="astro-section">
        <view class="astro-section-title">行星落座对比</view>
        <view class="planet-table">
          <view class="planet-row head">
            <text class="planet-name">行星</text><text class="planet-zodiac">你的</text><text class="planet-vs"></text><text class="planet-zodiac">TA的</text>
          </view>
          <view class="planet-row">
            <text class="planet-name">☉ 太阳</text>
            <text class="planet-zodiac">{{natalChart.my.planets.sun.zodiacSymbol}}{{natalChart.my.planets.sun.zodiacName}}</text>
            <text class="planet-vs">vs</text>
            <text class="planet-zodiac">{{natalChart.ta.planets.sun.zodiacSymbol}}{{natalChart.ta.planets.sun.zodiacName}}</text>
          </view>
          <view class="planet-row">
            <text class="planet-name">☽ 月亮</text>
            <text class="planet-zodiac">{{natalChart.my.planets.moon.zodiacSymbol}}{{natalChart.my.planets.moon.zodiacName}}</text>
            <text class="planet-vs">vs</text>
            <text class="planet-zodiac">{{natalChart.ta.planets.moon.zodiacSymbol}}{{natalChart.ta.planets.moon.zodiacName}}</text>
          </view>
          <view class="planet-row">
            <text class="planet-name">♀ 金星</text>
            <text class="planet-zodiac">{{natalChart.my.planets.venus.zodiacSymbol}}{{natalChart.my.planets.venus.zodiacName}}</text>
            <text class="planet-vs">vs</text>
            <text class="planet-zodiac">{{natalChart.ta.planets.venus.zodiacSymbol}}{{natalChart.ta.planets.venus.zodiacName}}</text>
          </view>
          <view class="planet-row">
            <text class="planet-name">♂ 火星</text>
            <text class="planet-zodiac">{{natalChart.my.planets.mars.zodiacSymbol}}{{natalChart.my.planets.mars.zodiacName}}</text>
            <text class="planet-vs">vs</text>
            <text class="planet-zodiac">{{natalChart.ta.planets.mars.zodiacSymbol}}{{natalChart.ta.planets.mars.zodiacName}}</text>
          </view>
          <view class="planet-row">
            <text class="planet-name">♃ 木星</text>
            <text class="planet-zodiac">{{natalChart.my.planets.jupiter.zodiacSymbol}}{{natalChart.my.planets.jupiter.zodiacName}}</text>
            <text class="planet-vs">vs</text>
            <text class="planet-zodiac">{{natalChart.ta.planets.jupiter.zodiacSymbol}}{{natalChart.ta.planets.jupiter.zodiacName}}</text>
          </view>
          <view class="planet-row">
            <text class="planet-name">♄ 土星</text>
            <text class="planet-zodiac">{{natalChart.my.planets.saturn.zodiacSymbol}}{{natalChart.my.planets.saturn.zodiacName}}</text>
            <text class="planet-vs">vs</text>
            <text class="planet-zodiac">{{natalChart.ta.planets.saturn.zodiacSymbol}}{{natalChart.ta.planets.saturn.zodiacName}}</text>
          </view>
        </view>
      </view>
      <view class="astro-section" wx:if="{{synastry.venusMarsAspects.length > 0}}">
        <view class="astro-section-title">🔥 金火相位 · 吸引力 {{synastry.attractionScore}}分</view>
        <view class="aspect-item" wx:for="{{synastry.venusMarsAspects}}" wx:key="desc">
          <text class="aspect-desc">{{item.desc}}</text>
          <text class="aspect-type {{item.positive ? 'pos' : 'neg'}}">{{item.symbol}} {{item.type}}</text>
        </view>
      </view>
      <view class="astro-section" wx:if="{{synastry.sunMoonAspects.length > 0}}">
        <view class="astro-section-title">🌞 日月相位 · 核心配合 {{synastry.coreFitScore}}分</view>
        <view class="aspect-item" wx:for="{{synastry.sunMoonAspects}}" wx:key="desc">
          <text class="aspect-desc">{{item.desc}}</text>
          <text class="aspect-type {{item.positive ? 'pos' : 'neg'}}">{{item.symbol}} {{item.type}}</text>
        </view>
      </view>
    </view>

    <!-- 个人性格星图 -->
    <view class="card astrology-card" wx:if="{{natalChart && !synastry && natalChart.my}}">
      <view class="card-title">🔮 你的个人性格星图</view>
      <view class="astro-section">
        <view class="astro-section-title">上升星座</view>
        <view class="pillar-name">{{natalChart.my.ascendant.zodiacSymbol}} {{natalChart.my.ascendant.zodiacName}}</view>
      </view>
      <view class="astro-section">
        <view class="astro-section-title">行星落座</view>
        <view class="planet-row"><text class="planet-name">☉ 太阳</text><text class="planet-zodiac">{{natalChart.my.planets.sun.zodiacSymbol}}{{natalChart.my.planets.sun.zodiacName}} {{natalChart.my.planets.sun.degree}}°</text><text class="planet-house">第{{natalChart.my.planets.sun.house}}宫</text></view>
        <view class="planet-row"><text class="planet-name">☽ 月亮</text><text class="planet-zodiac">{{natalChart.my.planets.moon.zodiacSymbol}}{{natalChart.my.planets.moon.zodiacName}} {{natalChart.my.planets.moon.degree}}°</text><text class="planet-house">第{{natalChart.my.planets.moon.house}}宫</text></view>
        <view class="planet-row"><text class="planet-name">♀ 金星</text><text class="planet-zodiac">{{natalChart.my.planets.venus.zodiacSymbol}}{{natalChart.my.planets.venus.zodiacName}} {{natalChart.my.planets.venus.degree}}°</text><text class="planet-house">第{{natalChart.my.planets.venus.house}}宫</text></view>
        <view class="planet-row"><text class="planet-name">♂ 火星</text><text class="planet-zodiac">{{natalChart.my.planets.mars.zodiacSymbol}}{{natalChart.my.planets.mars.zodiacName}} {{natalChart.my.planets.mars.degree}}°</text><text class="planet-house">第{{natalChart.my.planets.mars.house}}宫</text></view>
      </view>
    </view>

    <!-- 五维雷达 -->
    <view class="card radar-card">
      <view class="card-title">五维契合度</view>
      <view class="radar-wrap"><canvas type="2d" id="radarCanvas" class="radar-canvas"></canvas></view>
    </view>

    <!-- 完整解读 -->
    <view class="card main-card">
      <view class="card-title">💌 {{zodiacPair.copy.comboName}}</view>
      <view class="copy-summary">{{zodiacPair.copy.summary}}</view>
      <view class="tag-row"><text class="tag" wx:for="{{zodiacPair.copy.keywords}}" wx:key="index">{{item}}</text></view>
      <view class="copy-section"><view class="copy-label">✨ 心动优势</view><view class="copy-text">{{zodiacPair.copy.advantage}}</view></view>
      <view class="copy-section"><view class="copy-label">🌗 相爱挑战</view><view class="copy-text">{{zodiacPair.copy.challenge}}</view></view>
      <view class="copy-section"><view class="copy-label">💡 相处锦囊</view><view class="copy-item" wx:for="{{zodiacPair.copy.tips}}" wx:key="index">{{index + 1}}. {{item}}</view></view>
      <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
    </view>

    <!-- 传统论缘 -->
    <view class="card tao-card">
      <view class="card-title">☯ 传统视角 · {{zodiacPair.tao.elementName}}</view>
      <view class="tao-line">道：{{zodiacPair.tao.dao}}</view>
      <view class="tao-line">星：{{zodiacPair.tao.star}}</view>
      <view class="tao-line">阴阳：{{zodiacPair.tao.yinText}}</view>
      <view class="tao-seal">气属：{{zodiacPair.me.qi}} × {{zodiacPair.ta.qi}} · 守护星 {{zodiacPair.me.ruler}} 与 {{zodiacPair.ta.ruler}}</view>
    </view>
  </block>

  <!-- 仅出生信息匹配 -->
  <block wx:if="{{birthMatch && !zodiacPair}}">
    <view class="score-card">
      <view class="score-names">出生信息契合</view>
      <view class="score-big">{{birthMatch.totalScore}}</view>
      <view class="score-label">契合指数</view>
      <view class="score-tag">{{birthMatch.levelTag}}</view>
      <view class="score-phase">基于出生年份与生日分析</view>
    </view>
    <view class="card birth-card">
      <view class="card-title">🎂 出生信息契合度</view>
      <view class="birth-pillars">
        <view class="pillar-item"><view class="pillar-label">你的年份五行</view><view class="pillar-name">{{birthMatch.myPillar.full}}</view><view class="pillar-elem">{{birthMatch.myPillar.stemElement}}·{{birthMatch.myPillar.branchElement}}</view></view>
        <view class="pillar-vs">☯</view>
        <view class="pillar-item"><view class="pillar-label">TA的年份五行</view><view class="pillar-name">{{birthMatch.taPillar.full}}</view><view class="pillar-elem">{{birthMatch.taPillar.stemElement}}·{{birthMatch.taPillar.branchElement}}</view></view>
      </view>
      <view class="birth-detail">
        <view class="birth-detail-row"><text class="birth-detail-label">年龄差</text><text class="birth-detail-val">{{birthMatch.ageDiff}}岁 · {{birthMatch.ageText}}</text></view>
        <view class="birth-detail-row"><text class="birth-detail-label">年份属性</text><text class="birth-detail-val">{{birthMatch.stemRel.type}} · {{birthMatch.stemRel.text}}</text></view>
        <view class="birth-detail-row"><text class="birth-detail-label">地支属性</text><text class="birth-detail-val">{{birthMatch.branchRel.type}} · {{birthMatch.branchRel.text}}</text></view>
      </view>
      <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
    </view>
  </block>

  <!-- 单星座 -->
  <view class="card" wx:if="{{singleZodiac}}">
    <view class="card-title">🔮 {{singleZodiac.title}}</view>
    <view class="person-tag">{{singleZodiac.inflTag}}</view>
    <view class="copy-summary mt20">{{singleZodiac.theme}}</view>
    <view class="copy-section"><view class="copy-label">☯ 传统视角</view><view class="copy-text">{{singleZodiac.inflTao}}</view></view>
    <view class="copy-section"><view class="copy-label">✨ 星座视角</view><view class="copy-text">{{singleZodiac.inflStar}}</view></view>
    <view class="copy-section"><view class="copy-label">🌿 时节参考</view><view class="copy-text">{{singleZodiac.season}}</view></view>
    <view class="copy-section"><view class="copy-label">🕊 心语参考</view><view class="copy-text tao-quote">{{singleZodiac.tao}}</view></view>
    <view class="copy-section"><view class="copy-label">✨ 星座视角</view><view class="copy-text">{{singleZodiac.star}}</view></view>
    <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
  </view>

  <!-- 属相配对 -->
  <view class="card" wx:if="{{animalPair}}">
    <view class="card-title">🐾 生肖契合 · {{animalPair.relName}}</view>
    <view class="animal-top"><text class="animal-score">{{animalPair.score}}</text><text class="animal-tag">{{animalPair.relTag}}</text></view>
    <view class="copy-summary mt20">{{animalPair.copy.summary}}</view>
    <view class="copy-section"><view class="copy-label">✨ 优势</view><view class="copy-text">{{animalPair.copy.advantage}}</view></view>
    <view class="copy-section"><view class="copy-label">🌗 挑战</view><view class="copy-text">{{animalPair.copy.challenge}}</view></view>
    <view class="copy-section"><view class="copy-label">💡 锦囊</view><view class="copy-item" wx:for="{{animalPair.copy.tips}}" wx:key="index">{{index + 1}}. {{item}}</view></view>
    <view class="copy-section"><view class="copy-label">☯ 五行视角（{{animalPair.tao.rel}}）</view><view class="copy-text">{{animalPair.tao.dao}}</view><view class="copy-text mt20">{{animalPair.tao.star}}</view><view class="copy-text mt20 tao-quote">{{animalPair.yinText}}</view></view>
    <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
  </view>

  <!-- 单属相 -->
  <view class="card" wx:if="{{singleAnimal}}">
    <view class="card-title">🔮 {{singleAnimal.title}}</view>
    <view class="person-tag">{{singleAnimal.inflTag}}</view>
    <view class="copy-summary mt20">{{singleAnimal.theme}}</view>
    <view class="copy-section"><view class="copy-label">☯ 传统视角</view><view class="copy-text">{{singleAnimal.tao}}</view></view>
    <view class="copy-section"><view class="copy-label">✨ 星座视角</view><view class="copy-text">{{singleAnimal.star}}</view></view>
    <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
  </view>

  <!-- 年度状态 -->
  <view class="card year-card" wx:if="{{yearFortune}}">
    <view class="card-title">📜 {{year}}年 · 年度情感参考</view>
    <view class="year-ganzhi">{{yearFortune.ganZhi}} {{yearFortune.animal}}年 · 『{{yearFortune.theme}}』</view>
    <view class="copy-section"><view class="copy-label">☯ 传统视角</view><view class="copy-text">{{yearFortune.tao}}</view></view>
    <view class="copy-section"><view class="copy-label">✨ 星座视角</view><view class="copy-text">{{yearFortune.star}}</view></view>
    <view class="copy-section"><view class="copy-label">📈 整体情感参考</view><view class="copy-text">{{yearFortune.summary}}</view></view>
    <view class="copy-section"><view class="copy-label">🌗 干支参考</view><view class="copy-text">{{yearFortune.ganNote}}</view></view>
    <view class="entertain-tag">✦ 仅供娱乐 ✦</view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-area">
    <view class="btn-share" bindtap="onGenerateShare"><text class="share-icon">📤</text> 生成分享卡片</view>
    <view class="btn-primary mt20" bindtap="goTarot">✨ 继续 · 趣味卡牌</view>
    <view class="btn-ghost mt20" bindtap="goMatching">重新分析</view>
    <view class="btn-ghost mt20" bindtap="goHome">返回首页</view>
  </view>

  <view class="page-footer">
    <view class="footer-line"></view>
    <view class="footer-entertain">✦ 仅供娱乐参考 ✦</view>
    <view class="footer-copyright">@copyright 2026 Victoria_Tao</view>
  </view>

  <view class="share-canvas-wrap"><canvas type="2d" id="shareCanvas" class="share-canvas"></canvas></view>

  <view class="share-modal" wx:if="{{showShareModal}}" bindtap="closeShareModal">
    <view class="share-modal-content" catchtap="">
      <view class="share-modal-title">分享卡片已生成</view>
      <scroll-view scroll-y class="share-modal-scroll">
        <image class="share-modal-img" src="{{shareImg}}" mode="widthFix"></image>
      </scroll-view>
      <view class="share-modal-tip">长按图片可保存或发送给朋友</view>
      <view class="share-modal-btns">
        <view class="btn-primary share-save" bindtap="onSaveShare">保存到相册</view>
        <view class="btn-ghost share-close" bindtap="closeShareModal">关闭</view>
      </view>
    </view>
  </view>
</view>
