/* pages/tarot/tarot-result/tarot-result.wxss 趣味卡牌结果（B方向排版：牌面放大+解读淡化） */

.page {
  min-height: 100vh;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 20rpx 0 30rpx;
  position: relative;
}

.header::before {
  content: '✦';
  position: absolute;
  top: 18rpx;
  left: 18%;
  font-size: 24rpx;
  color: rgba(255, 215, 0, 0.5);
}

.header::after {
  content: '✨';
  position: absolute;
  top: 14rpx;
  right: 18%;
  font-size: 28rpx;
  opacity: 0.5;
}

/* ===== 牌面（B方向：放大突出） ===== */
.card-face-wrap {
  position: relative;
  width: 100%;
  margin-bottom: 28rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 44rpx rgba(0, 0, 0, 0.45), 0 0 32rpx rgba(255, 180, 50, 0.2);
  border: 2rpx solid rgba(255, 215, 0, 0.25);
  background: linear-gradient(135deg, #2d1b5e 0%, #4a2c7a 50%, #6b3a8a 100%);
}

.card-face-img {
  width: 100%;
  height: 720rpx;
  display: block;
}

.card-face-img.reversed {
  transform: rotate(180deg);
}

/* 正逆位角标 */
.card-face-mark {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  backdrop-filter: blur(8px);
  z-index: 2;
}

.card-face-mark.upright {
  background: rgba(255, 215, 0, 0.3);
  border: 1rpx solid rgba(255, 215, 0, 0.55);
  color: #ffd700;
}

.card-face-mark.reversed {
  background: rgba(140, 160, 220, 0.3);
  border: 1rpx solid rgba(140, 160, 220, 0.55);
  color: #a0b0e0;
}

/* ===== 牌面信息（B方向：缩小淡化） ===== */
.card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 215, 0, 0.12);
  border-radius: 26rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.card-info {
  padding: 0 4rpx;
}

.info-position {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255, 215, 0, 0.8);
  margin-bottom: 10rpx;
}

.info-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.9;
  margin: 12rpx 0;
}

/* 综合解读框 */
.summary-box {
  background: rgba(255, 215, 0, 0.08);
  border: 1rpx solid rgba(255, 215, 0, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.summary-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffd700;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.summary-text {
  font-size: 25rpx;
  line-height: 1.8;
  color: rgba(255, 235, 180, 0.8);
}

/* 分维度指引框 */
.love-box {
  background: rgba(240, 168, 192, 0.08);
  border: 1rpx solid rgba(240, 168, 192, 0.2);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  backdrop-filter: blur(8px);
}

.love-label {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(240, 168, 192, 0.85);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.dim-item {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.dim-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.dim-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffd700;
  margin-bottom: 6rpx;
}

.dim-text {
  font-size: 24rpx;
  color: rgba(240, 200, 215, 0.75);
  line-height: 1.8;
}

/* 最终综合总结卡片 */
.final-card {
  background: linear-gradient(135deg, rgba(240, 168, 192, 0.12), rgba(196, 168, 232, 0.12));
  border: 1rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin: 30rpx 0;
  backdrop-filter: blur(10px);
}

.final-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffd700;
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.final-content {
  font-size: 26rpx;
  line-height: 2;
  color: rgba(255, 255, 255, 0.85);
  white-space: pre-wrap;
}

.btn-save {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  padding: 22rpx;
  border-radius: 40rpx;
  letter-spacing: 4rpx;
}

/* 保存图片弹窗 */
.save-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.save-modal-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.save-scroll {
  width: 100%;
  height: 62vh;
  margin-bottom: 20rpx;
}

.save-preview {
  width: 100%;
  border-radius: 16rpx;
  display: block;
}

.save-btn {
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.save-cancel {
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  padding: 12rpx;
  flex-shrink: 0;
}

.btn-primary {
  margin-top: 20rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.disclaimer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}
