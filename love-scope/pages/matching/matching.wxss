/* pages/matching/matching.wxss 配对表单（星夜玻璃态·含出生信息） */

.page {
  min-height: 100vh;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 20rpx 0 36rpx;
  position: relative;
}

.header::before {
  content: '🌙';
  position: absolute;
  top: 14rpx;
  left: 15%;
  font-size: 32rpx;
  opacity: 0.6;
}

.header::after {
  content: '✨';
  position: absolute;
  top: 18rpx;
  right: 15%;
  font-size: 28rpx;
  opacity: 0.5;
}

/* 表单卡片（玻璃态） */
.card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.card .select-row {
  padding: 28rpx 4rpx;
}

.card .select-label {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
}

.card .select-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffd700;
}

.card .select-value.text-dim {
  color: rgba(255, 255, 255, 0.35);
  font-weight: 500;
}

.card .select-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-left: 10rpx;
  background: rgba(255, 215, 0, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.card .select-arrow {
  font-size: 36rpx;
  color: rgba(255, 215, 0, 0.35);
  margin-left: 10rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 215, 0, 0.95);
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin: 4rpx 0 16rpx;
  line-height: 1.6;
  background: rgba(255, 215, 0, 0.06);
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  border-left: 4rpx solid rgba(255, 215, 0, 0.25);
}

.divider {
  height: 1rpx;
  background: rgba(255, 215, 0, 0.1);
  margin: 0 4rpx;
}

/* ===== 出生信息模块 ===== */
.birth-card {
  background: rgba(255, 215, 0, 0.06);
  border-color: rgba(255, 215, 0, 0.2);
}

.birth-section {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx;
}

.birth-person {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 215, 0, 0.85);
  min-width: 80rpx;
  flex-shrink: 0;
}

.birth-inputs {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.birth-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.birth-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
  font-size: 24rpx;
}

.birth-picker {
  flex: 1;
  min-width: 0;
}

.birth-picker-box {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.birth-picker-box.ph {
  color: rgba(255, 255, 255, 0.3);
}

.birth-auto {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: rgba(255, 215, 0, 0.08);
  border-radius: 14rpx;
  border-left: 4rpx solid rgba(255, 215, 0, 0.3);
}

.birth-auto-text {
  font-size: 22rpx;
  color: rgba(255, 215, 0, 0.8);
  line-height: 1.6;
}

.btn-primary {
  margin-top: 36rpx;
  font-size: 34rpx;
  letter-spacing: 6rpx;
}

.disclaimer {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}
