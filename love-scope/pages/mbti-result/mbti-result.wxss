/* pages/mbti-result/mbti-result.wxss 性格速配结果 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1040 0%, #2d1b5e 50%, #1a1040 100%);
  padding-bottom: 80rpx;
}

/* 顶部标题 */
.header {
  text-align: center;
  padding: 70rpx 0 50rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffd700;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}
.header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 3rpx;
}

/* 双方MBTI展示 */
.mbti-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  padding: 30rpx 0 50rpx;
}
.mbti-side {
  text-align: center;
  min-width: 200rpx;
}
.mbti-type {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 0 24rpx rgba(255,180,100,0.5);
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}
.mbti-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 2rpx;
}
.mbti-vs {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.35);
  letter-spacing: 2rpx;
}

/* 综合分数卡片 */
.score-card {
  margin: 20rpx 50rpx 50rpx;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,180,100,0.25);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  text-align: center;
}
.score-number {
  font-size: 96rpx;
  font-weight: 900;
  color: #ffb464;
  line-height: 1;
  text-shadow: 0 0 36rpx rgba(255,180,100,0.5);
  letter-spacing: 4rpx;
}
.score-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}
.score-tag {
  font-size: 34rpx;
  font-weight: 700;
  color: #f0a8c0;
  margin-top: 24rpx;
  letter-spacing: 4rpx;
}

/* 通用区块 */
.section-block {
  margin: 0 30rpx 40rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffd700;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #ffb464;
  letter-spacing: 2rpx;
}

/* 雷达图区域 */
.radar-section {
  margin: 0 30rpx 40rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 28rpx;
  padding: 36rpx 30rpx 20rpx;
}
.radar-canvas {
  width: 100%;
  height: 400rpx;
}

/* 维度详情 */
.details-section {
  margin: 0 30rpx 40rpx;
}
.detail-item {
  background: rgba(255,255,255,0.04);
  border-radius: 22rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
}
.detail-item:last-child {
  margin-bottom: 0;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.detail-dim {
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}
.detail-score {
  font-size: 25rpx;
  font-weight: 700;
  color: #ffd700;
}
.detail-bar-bg {
  height: 12rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
}
.detail-bar {
  height: 100%;
  background: linear-gradient(90deg, #ffb464, #f0a8c0);
  border-radius: 6rpx;
}
.detail-text {
  font-size: 23rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.9;
  letter-spacing: 1rpx;
}

/* 综合总结 */
.summary-section {
  margin: 0 30rpx 40rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
}
.summary-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.82);
  line-height: 2;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}
.summary-text:last-child {
  margin-bottom: 0;
}
.sub-title {
  font-size: 27rpx;
  font-weight: 700;
  margin: 32rpx 0 18rpx;
  letter-spacing: 2rpx;
}
.advantage-title {
  color: #ffb464;
}
.challenge-title {
  color: #f0a8c0;
}

/* 操作按钮 */
.actions {
  margin: 20rpx 30rpx 50rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #ffb464, #f0a8c0);
  color: #2d1b5e;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  padding: 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 28rpx rgba(255,180,100,0.25);
  letter-spacing: 4rpx;
}
.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-secondary {
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.75);
  font-size: 28rpx;
  text-align: center;
  padding: 26rpx;
  border-radius: 50rpx;
  letter-spacing: 3rpx;
}
.btn-secondary:active {
  opacity: 0.8;
}

/* 底部版权 */
.page-footer {
  margin-top: 30rpx;
  text-align: center;
  padding: 30rpx;
}
.footer-line {
  width: 120rpx;
  height: 1rpx;
  background: rgba(255,215,0,0.15);
  margin: 0 auto 20rpx;
}
.footer-entertain {
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}
.footer-copyright {
  font-size: 18rpx;
  color: rgba(255,255,255,0.25);
  letter-spacing: 1rpx;
}

/* 分享卡片弹窗 */
.share-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.85);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.share-popup {
  width: 640rpx;
  max-height: 88vh;
  background: #1a1040;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.share-scroll {
  flex: 1;
  max-height: 72vh;
}
.share-image {
  width: 100%;
  display: block;
}
.share-actions {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 30rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
}
.share-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.share-btn.save {
  background: linear-gradient(135deg, #ffb464, #f0a8c0);
  color: #2d1b5e;
}
.share-btn.close {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.75);
}

/* 隐藏的分享画布 */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1400px;
}
