<!-- pages/mbti-result/mbti-result.wxml 性格速配结果 -->
<view class="page">
  <!-- 顶部标题 -->
  <view class="header">
    <view class="header-title">✦ 性格速配报告 ✦</view>
    <view class="header-sub">MBTI 双人性格匹配</view>
  </view>

  <!-- 双方MBTI展示 -->
  <view class="mbti-display">
    <view class="mbti-side">
      <view class="mbti-type">{{myMbti}}</view>
      <view class="mbti-name">{{mbtiResult.typeA.name}}</view>
    </view>
    <view class="mbti-vs">VS</view>
    <view class="mbti-side">
      <view class="mbti-type">{{taMbti}}</view>
      <view class="mbti-name">{{mbtiResult.typeB.name}}</view>
    </view>
  </view>

  <!-- 综合分数 -->
  <view class="score-card">
    <view class="score-number">{{mbtiResult.score}}</view>
    <view class="score-label">性格匹配度</view>
    <view class="score-tag">「{{mbtiResult.tag}}」</view>
  </view>

  <!-- 四维雷达图 -->
  <view class="radar-section">
    <view class="section-title">四维性格分析</view>
    <canvas canvas-id="radarCanvas" class="radar-canvas"></canvas>
  </view>

  <!-- 各维度详情 -->
  <view class="details-section">
    <view class="section-title">维度详解</view>
    <view class="detail-item" wx:for="{{mbtiResult.details}}" wx:key="dim">
      <view class="detail-header">
        <text class="detail-dim">{{item.dim}}</text>
        <text class="detail-score">{{item.score}}分</text>
      </view>
      <view class="detail-bar-bg">
        <view class="detail-bar" style="width: {{item.score}}%"></view>
      </view>
      <view class="detail-text">{{item.text}}</view>
    </view>
  </view>

  <!-- 综合总结 -->
  <view class="summary-section">
    <view class="section-title">综合解读</view>
    <view class="summary-text">{{mbtiResult.summary}}</view>

    <view class="sub-title advantage-title">✦ 契合优势</view>
    <view class="summary-text">{{mbtiResult.advantage}}</view>

    <view class="sub-title challenge-title">✦ 相处建议</view>
    <view class="summary-text">{{mbtiResult.challenge}}</view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="btn-primary" bindtap="saveCard">保存结果卡片</view>
    <view class="btn-secondary" bindtap="goHome">返回首页</view>
  </view>

  <!-- 底部版权 -->
  <view class="page-footer">
    <view class="footer-line"></view>
    <view class="footer-entertain">✦ 仅供娱乐参考 ✦</view>
    <view class="footer-copyright">@copyright 2026 Victoria_Tao</view>
  </view>

  <!-- 分享卡片弹窗 -->
  <view class="share-mask" wx:if="{{showShare}}" bindtap="closeShare">
    <view class="share-popup" catchtap="">
      <scroll-view scroll-y class="share-scroll">
        <image src="{{shareImage}}" mode="widthFix" class="share-image"></image>
      </scroll-view>
      <view class="share-actions">
        <view class="share-btn save" bindtap="saveImage">保存到相册</view>
        <view class="share-btn close" bindtap="closeShare">关闭</view>
      </view>
    </view>
  </view>

  <!-- 隐藏的分享画布 -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
