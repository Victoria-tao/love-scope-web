/* pages/personal/mbti-test/mbti-test.wxss */
.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 开始界面 */
.start-page {
  text-align: center;
  padding: 80rpx 40rpx;
}

.start-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.start-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 20rpx;
}

.start-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.8;
  margin-bottom: 50rpx;
}

.start-tips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 60rpx;
}

.tip-item {
  font-size: 24rpx;
  color: rgba(255, 215, 0, 0.7);
}

.start-btn {
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-size: 32rpx;
  font-weight: 700;
  padding: 28rpx 80rpx;
  border-radius: 40rpx;
  display: inline-block;
}

/* 答题界面 */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700, #f0a8c0);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: right;
  margin-bottom: 30rpx;
}

.question-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
}

.question-num {
  font-size: 24rpx;
  color: #f0a8c0;
  margin-bottom: 16rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.6;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.2s;
}

.option-card:active {
  background: rgba(240, 168, 192, 0.15);
  border-color: rgba(240, 168, 192, 0.4);
  transform: scale(0.98);
}

.option-label {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 50%;
  flex-shrink: 0;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

/* 结果界面 */
.result-header {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.cat-image {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  border: 4rpx solid rgba(255, 215, 0, 0.4);
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
  background: rgba(255, 255, 255, 0.05);
}

.result-type {
  font-size: 72rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: 8rpx;
}

.result-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin: 10rpx 0;
}

.result-trait {
  font-size: 24rpx;
  color: rgba(255, 215, 0, 0.7);
}

.result-desc {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
}

.detail-section {
  margin-bottom: 30rpx;
}

.detail-block {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.detail-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #f0a8c0;
  margin-bottom: 10rpx;
}

.detail-text {
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.75);
}

/* 保存图片弹窗 */
.save-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.save-modal-content {
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.save-scroll {
  width: 100%;
  max-height: 65vh;
  margin-bottom: 30rpx;
}

.save-preview {
  width: 100%;
  border-radius: 20rpx;
  display: block;
}

.save-btn-action {
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
}

.save-cancel {
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  padding: 16rpx;
}

.dim-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffd700;
  margin-bottom: 20rpx;
}

.dim-item {
  margin-bottom: 24rpx;
}

.dim-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dim-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.dim-label.dominant {
  color: #f0a8c0;
  font-weight: 700;
}

.dim-bar {
  display: flex;
  height: 14rpx;
  border-radius: 7rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.dim-left {
  background: linear-gradient(90deg, #c4a8e8, #f0a8c0);
  height: 100%;
}

.dim-right {
  background: linear-gradient(90deg, #f0a8c0, #ffd700);
  height: 100%;
}

.dim-percents {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}

.action-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #ffd700, #f0a8c0);
  color: #2d1b5e;
  font-weight: 700;
}

.action-btn.ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.8);
}

.action-btn.text {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
}

.page-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-line {
  width: 120rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 auto 16rpx;
}

.footer-entertain {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 8rpx;
}

.footer-copyright {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}
